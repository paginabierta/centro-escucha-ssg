rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function miRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        miRol() == 'admin';
    }

    // Rutas por municipio: cualquiera las puede LEER (el sitio público las muestra),
    // pero solo el administrador puede escribirlas.
    match /rutas/{municipioId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Agentes del equipo (sacerdotes/psicólogos disponibles para citas):
    // lectura pública (el formulario los muestra), escritura solo admin.
    match /agentes/{agenteId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Configuración de tema (paleta de colores y tipografía del sitio):
    // lectura pública (todas las páginas la aplican), escritura solo admin.
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Equipo de apoyo (sacerdotes, psicólogos, trabajadores sociales, etc.):
    // lectura pública (página "Equipo de Apoyo"), escritura solo admin.
    match /equipo_apoyo/{miembroId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Reflexiones de la sección "Motivación": lectura pública, escritura solo admin.
    match /reflexiones/{reflexionId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Solicitudes de cita: CUALQUIERA puede CREAR una (es el formulario público),
    // pero nadie externo puede leer, editar ni borrar — solo el equipo autenticado.
    match /citas/{citaId} {
      allow create: if true;
      allow read, update, delete: if estaAutenticado();
    }

    // Casos de la bitácora: NUNCA públicos. Solo el equipo autenticado puede leer/crear,
    // y cada agente solo ve sus propios casos (el admin ve todos, filtrado en el cliente
    // por la consulta, pero igual restringido aquí a estar autenticado).
    match /casos/{casoId} {
      allow create: if estaAutenticado();
      allow read: if estaAutenticado() &&
        (esAdmin() || resource.data.registradoPorUid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Usuarios y roles: cada quien puede leer su propio documento de rol;
    // solo el administrador puede crear o cambiar roles.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }
  }
}
