rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function miRol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        miRol() == 'admin';
    }

    // Rutas por municipio: cualquiera las puede LEER (el sitio público las muestra),
    // pero solo el administrador puede escribirlas.
    match /rutas/{municipioId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Casos de la bitácora: NUNCA públicos. Solo el equipo autenticado puede leer/crear,
    // y cada agente solo ve sus propios casos (el admin ve todos, filtrado en el cliente
    // por la consulta, pero igual restringido aquí a estar autenticado).
    match /casos/{casoId} {
      allow create: if estaAutenticado();
      allow read: if estaAutenticado() &&
        (esAdmin() || resource.data.registradoPorUid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Usuarios y roles: cada quien puede leer su propio documento de rol;
    // solo el administrador puede crear o cambiar roles.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }
  }
}
